CHARTEROS_ENVIRONMENT=development
CHARTEROS_SERVICE_NAME=charteros-api
CHARTEROS_LOG_LEVEL=INFO
CHARTEROS_DEV_POSTGRES_PASSWORD=replace-with-random-local-password
CHARTEROS_DATABASE_URL=postgresql+psycopg://charteros:replace-with-random-local-password@localhost:5432/charteros
CHARTEROS_DATABASE_POOL_SIZE=10
CHARTEROS_DATABASE_MAX_OVERFLOW=10
CHARTEROS_DATABASE_POOL_TIMEOUT_SECONDS=5.0
CHARTEROS_DATABASE_POOL_RECYCLE_SECONDS=1800
CHARTEROS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Production runtime may assume the non-owner role provisioned after migrations when the
# deployment connects with a migrator-capable identity.
# CHARTEROS_DATABASE_RUNTIME_ROLE=charteros_runtime
# Safe host default is 127.0.0.1. Containers explicitly override this to 0.0.0.0.
CHARTEROS_API_HOST=127.0.0.1
CHARTEROS_API_PORT=8000
CHARTEROS_API_MAX_REQUEST_BODY_BYTES=1048576
CHARTEROS_API_MAX_JSON_DEPTH=32
CHARTEROS_API_REQUEST_BODY_READ_TIMEOUT_SECONDS=10.0
# Staging/production must set this true only when trusted ingress/API-gateway rate limiting exists.
CHARTEROS_TRUSTED_INGRESS_RATE_LIMIT_ENFORCED=false
CHARTEROS_API_RATE_LIMIT_WINDOW_SECONDS=60
CHARTEROS_API_MATCHING_REQUESTS_PER_WINDOW=300
CHARTEROS_API_REPOSITIONING_REQUESTS_PER_WINDOW=60
CHARTEROS_API_EVIDENCE_REQUESTS_PER_WINDOW=120
CHARTEROS_API_GRAPH_REQUESTS_PER_WINDOW=600
CHARTEROS_API_RATE_LIMIT_WINDOW_RETENTION_SECONDS=7200

# External OIDC/JWT authentication. Development may omit all three and fail closed on /v1.
# Staging/production require the complete issuer/audience/JWKS tuple at startup.
# CHARTEROS_AUTH_ISSUER=https://id.example.com/
# CHARTEROS_AUTH_AUDIENCE=charteros-api
# CHARTEROS_AUTH_JWKS_URL=https://id.example.com/.well-known/jwks.json
CHARTEROS_AUTH_ALLOWED_ALGORITHMS=RS256,ES256
CHARTEROS_AUTH_JWKS_CACHE_TTL_SECONDS=300
CHARTEROS_AUTH_JWKS_MAX_KEYS=64
CHARTEROS_AUTH_JWKS_MAX_DOCUMENT_BYTES=262144
CHARTEROS_AUTH_JWKS_REFRESH_MIN_INTERVAL_SECONDS=5.0
CHARTEROS_AUTH_JWKS_UNKNOWN_KEY_TTL_SECONDS=5.0
CHARTEROS_AUTH_JWKS_NEGATIVE_CACHE_MAX_KEYS=128
CHARTEROS_AUTH_HTTP_TIMEOUT_SECONDS=2.0
CHARTEROS_AUTH_JWT_LEEWAY_SECONDS=0.0

CHARTEROS_OUTBOX_BATCH_SIZE=32
CHARTEROS_OUTBOX_POLL_INTERVAL_SECONDS=1.0
CHARTEROS_OUTBOX_LEASE_SECONDS=30
CHARTEROS_OUTBOX_MAX_ATTEMPTS=8
CHARTEROS_OUTBOX_BACKOFF_BASE_SECONDS=1
CHARTEROS_OUTBOX_BACKOFF_MAX_SECONDS=300

CHARTEROS_IDEMPOTENCY_RETENTION_DAYS=90
CHARTEROS_IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000
